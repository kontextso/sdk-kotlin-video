# Local development overrides.
#
# 1. Copy this file to `local.properties` in the repo root (next to settings.gradle.kts).
#    Android Studio will already have created `local.properties` for `sdk.dir`;
#    just append the keys below to that file.
# 2. `local.properties` is gitignored — local-only settings won't be committed.

# Set to false to resolve `so.kontext.kit:kontext-kit-android` from Maven
# Central instead of the local `../kontextkit-android` checkout. Leave unset
# (or true) to use the local composite build when that sibling repo exists.
useLocalKontextkit=true
