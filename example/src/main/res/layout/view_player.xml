<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView surface: a normal view in the hierarchy, so it's clipped to
     its layout bounds (a SurfaceView renders in a separate layer and can
     overflow the composable, making the video look cropped / show "below").
     resize_mode=fit shows the whole frame (letterboxed), never cropped.
     show_buffering=when_playing draws Media3's built-in loading spinner while
     the stream stalls to (re)buffer (default is never = frozen frame). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:resize_mode="fit"
    app:show_buffering="when_playing"
    app:use_controller="true" />
