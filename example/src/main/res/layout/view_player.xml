<?xml version="1.0" encoding="utf-8"?>
<!-- SurfaceView surface: the compositor owns it, so switching between
     differently-sized videos never leaves a stale "ghost" frame (a
     TextureView does). On modern Android the SurfaceView still clips to
     the parent's rounded-corner outline. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view"
    app:resize_mode="fit"
    app:use_controller="true" />
