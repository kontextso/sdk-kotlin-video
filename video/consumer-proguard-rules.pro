# Kontext Video SDK consumer ProGuard rules.
#
# Packaged in the AAR; auto-applied by R8 in the consuming app's release
# build. Their only job is to stop R8 from breaking what the SDK can't
# defend itself: public API names referenced by consumer code and
# serializer classes generated by kotlinx.serialization.

# ---------------------------------------------------------------------------
# Public API: top-level entry point
# ---------------------------------------------------------------------------
-keep public class so.kontext.video.KontextVideo { public *; }

# ---------------------------------------------------------------------------
# kotlinx.serialization
# ---------------------------------------------------------------------------
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.AnnotationsKt
